# Copy this file to `.env` and fill in your own keys. Never commit the real .env.

# --- Speech-to-text (required) ---
# Deepgram realtime + batch STT. https://console.deepgram.com/
DEEPGRAM_API_KEY=

# --- LLM (required) ---
# Groq (OpenAI-compatible). https://console.groq.com/keys
GROQ_API_KEY=

# --- Text-to-speech (at least one required) ---
# ElevenLabs is the default provider. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Cartesia (optional fallback). https://play.cartesia.ai/
CARTESIA_API_KEY=

# Google Gemini TTS (optional fallback). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
