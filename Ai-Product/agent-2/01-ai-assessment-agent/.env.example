# AI Assessment Agent - environment. Copy to .env and fill in. Never commit .env.

# --- Server ---
AIA_PORT=5060
# Signs session tokens. 32+ random characters. Empty = a random one per start (demo only).
AIA_JWT_SECRET=
# true = create the demo school (password demo1234) and show demo logins. Set false for real use.
AIA_DEMO_MODE=true
# Database folder (embedded PostgreSQL / PGlite). Default: ./data/db
AIA_DATA_DIR=
# true = keep everything in memory (lost on exit)
AIA_IN_MEMORY=false

# --- AI provider (optional: without it, manual tests, attempts, reports and assignments still work) ---
# groq | gemini | huggingface
AIA_LLM_PROVIDER=
# groq default: openai/gpt-oss-120b   gemini e.g. gemini-2.5-flash   huggingface e.g. Qwen/Qwen3-Next-80B-A3B-Instruct:novita
AIA_LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
# Hugging Face user token (hf_...)
HF_TOKEN=

# "false" turns AI generation off. Default on when configured.
AIA_AI_GENERATION_ENABLED=true
# Per-request timeout, 5000-120000 ms
AIA_LLM_TIMEOUT_MS=60000
# TEMPORARY in the original: true shows AI performance reports that failed strict validation, marked "not validated"
AIA_REPORT_PREVIEW_MODE=false

# --- Files (absolute paths; default ./data/...) ---
AIA_SUBMISSIONS_DIR=
AIA_QUESTION_IMAGES_DIR=

# --- Legacy names (read only as fallbacks; inherited from the LMS, where both AI modules shared one config) ---
# Used when AIA_LLM_PROVIDER is empty. Prefer the AIA_* names above.
# SOA_LLM_PROVIDER=
# SOA_LLM_MODEL=
# SOA_GEMINI_API_KEY=     (GEMINI_API_KEY above is copied into this at start-up)
# SOA_GROQ_API_KEY=       (alternative to GROQ_API_KEY)

# --- Web client build (client/.env or the shell, at `npm run build:client`) ---
# Empty = same origin as this server. Set to another server's /api to host the client separately.
# VITE_API_BASE=
