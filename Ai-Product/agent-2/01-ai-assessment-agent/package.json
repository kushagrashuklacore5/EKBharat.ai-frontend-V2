{
  "name": "ai-assessment-agent",
  "version": "1.0.0",
  "description": "AI Assessment Agent (standalone): teachers create MCQ / multi-select / numerical tests by hand or with AI (Groq, Gemini, Hugging Face), students take timed attempts, AI performance reports and AI-assisted marking of PDF assignments.",
  "private": true,
  "license": "UNLICENSED",
  "main": "backend/src/standalone/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node backend/src/standalone/server.js",
    "dev": "node --watch backend/src/standalone/server.js",
    "setup": "npm install && npm --prefix client install && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "test": "node --test",
    "demo": "node scripts/demo.js",
    "llm:check": "node scripts/llm-check.js",
    "test:ai": "node --test \"tests/ai/*.test.js\" \"tests/analytics/*.test.js\" tests/questionTypes/generation.test.js tests/assignments/evaluation.test.js",
    "test:assignments": "node --test \"tests/assignments/*.test.js\"",
    "cost:estimate": "node tests/manual/estimatePromptCost.js",
    "llm:check:assignments": "node tests/manual/realAssignmentEvalCheck.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pdf-parse": "2.4.5"
  }
}
