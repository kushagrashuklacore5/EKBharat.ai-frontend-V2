# Local config for the proctoring backend.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Allow the Ek Bharat app origins (also reached same-origin via the Vite /ws proxy).
CORS_ORIGINS=["http://localhost:5176","http://127.0.0.1:5176","http://localhost:5173","http://localhost:5175"]

# --- Inference (CPU) ---
DEVICE=cpu
POSE_MODEL=yolo11n-pose.pt
POSE_CONF=0.35
POSE_MAX_PERSONS=5

# --- Detector strides ---
STRIDE_POSE=1
STRIDE_FACE=1
STRIDE_LANDMARKS=1
STRIDE_OBJECTS=2
STRIDE_EMOTION=5
STRIDE_IDENTITY=5

# --- Thresholds ---
EAR_CLOSED_THRESH=0.18
MAR_TALKING_THRESH=0.35
GAZE_CENTER_TOL_DEG=12
HEADPOSE_AWAY_YAW_DEG=30

# --- Risk ---
RISK_WARN_THRESH=40
RISK_ALERT_THRESH=65
ALERT_MIN_DURATION_S=1.5
