# Copy to .env and edit. All of these override backend/app/config.py defaults.

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Video / transport ---
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=12
JPEG_QUALITY=0.7
DROP_STALE_FRAMES=true
RETURN_DEBUG_JPEG=false

# --- Inference ---
# DEVICE=cpu on this machine (no NVIDIA GPU). Set DEVICE=cuda on a T4 host and
# install onnxruntime-gpu + a CUDA torch build.
DEVICE=cpu
POSE_MODEL=yolo11n-pose.pt      # use yolo11s-pose.pt on GPU for higher accuracy
POSE_CONF=0.35
POSE_MAX_PERSONS=5

# --- Detector strides (run heavy stages every Nth frame) ---
STRIDE_POSE=1
STRIDE_FACE=1
STRIDE_LANDMARKS=1
STRIDE_OBJECTS=2
STRIDE_EMOTION=5
STRIDE_IDENTITY=5

# --- Thresholds ---
EAR_CLOSED_THRESH=0.18
MAR_TALKING_THRESH=0.35
GAZE_CENTER_TOL_DEG=12
HEADPOSE_AWAY_YAW_DEG=30

# --- Risk (baseline) ---
RISK_WARN_THRESH=40
RISK_ALERT_THRESH=65
ALERT_MIN_DURATION_S=1.5
