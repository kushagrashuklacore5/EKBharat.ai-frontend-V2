# CPU-lite profile: faster single-student proctoring on a CPU-only host.
# Copy to .env to use.  Trades the heaviest appearance models for the (tested) geometric
# estimators, which keeps identity/objects/emotion but drops ~600ms/frame on a slow CPU.
#
# Measured on an 8-thread laptop CPU:
#   full stack (SCRFD@384 + 6DRepNet-torch): ~400 ms/frame (2.5 fps)
#   this lite profile:                        ~250-300 ms/frame (3-4 fps)
# A T4 runs the FULL stack in <150 ms/frame; use the defaults there.

DEVICE=cpu

# Drop SCRFD (use MediaPipe face box) -- saves ~340 ms/frame.
USE_SCRFD=false

# Geometric head pose (solvePnP) instead of 6DRepNet -- saves ~230 ms/frame.
USE_6DREPNET=false

# Geometric gaze (iris) -- already the default until l2cs.onnx is exported.
USE_L2CS=false

# Run objects every 3rd frame, emotion/identity every 6th.
STRIDE_OBJECTS=3
STRIDE_EMOTION=6
STRIDE_IDENTITY=6

# Smaller SCRFD input if you keep USE_SCRFD=true.
SCRFD_INPUT=320

# Smaller pose/object inference size -- the biggest single CPU lever (runs every frame).
POSE_IMGSZ=320
OBJECT_IMGSZ=320
STRIDE_HEAD=3
STRIDE_FACE_DETECT=3
